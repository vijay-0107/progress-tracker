{
  "name": "progress-tracker",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5177",
    "build": "npm run typecheck && npm run check:content && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4177",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --exclude tests/rules.test.ts",
    "check:content": "vitest run tests/content.test.ts tests/books.test.ts",
    "test:rules": "firebase emulators:exec --project demo-progress-tracker --only auth,firestore \"vitest run tests/rules.test.ts\"",
    "test:e2e": "playwright test",
    "emulators": "firebase emulators:start --project demo-progress-tracker --only auth,firestore",
    "config:local": "node scripts/write-firebase-config.mjs --local",
    "config:deploy": "node scripts/write-firebase-config.mjs",
    "content:import": "node scripts/import-curriculum.mjs",
    "format": "prettier --write src tests scripts *.ts index.html",
    "format:check": "prettier --check src tests scripts *.ts index.html"
  },
  "dependencies": {
    "firebase": "^12.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.5.0",
    "firebase-tools": "^14.0.0",
    "prettier": "^3.6.2",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^3.2.0"
  }
}
